# Valores del sitio publicado. Next lee este archivo solo en `next build`, así
# que .env.local puede seguir apuntando al motor local sin contaminar la
# exportación: antes de separarlos, el build horneaba http://localhost:3000 en
# el JavaScript y el buscador quedaba muerto para todo visitante.
#
# Aquí no va ningún secreto: todo lo que empieza con NEXT_PUBLIC_ viaja al
# navegador y es legible por cualquiera. Por eso este archivo sí se versiona.
NEXT_PUBLIC_WHATSAPP=524611801622
NEXT_PUBLIC_EMAIL=hola@apoumian.com
NEXT_PUBLIC_AUDITORIAS_URL=https://auditorias.apoumian.com
