# ─── Cómo se reparten los archivos de entorno ────────────────────────────────
# .env.production        → se versiona. Valores del sitio publicado. Sin secretos:
#                          todo NEXT_PUBLIC_ viaja al navegador y es legible.
# .env.development.local → solo `next dev`. Aquí van los apuntes a localhost.
# .env.local             → se aplica en dev Y en build. Ojo: lo que se ponga aquí
#                          pisa a .env.production y acaba horneado en el sitio.
#
# El formulario de contacto ya no usa Resend: en hosting compartido lo atiende
# public/contacto.php con el correo del propio dominio. El buzón de destino se
# configura arriba de ese archivo, no aquí.

NEXT_PUBLIC_WHATSAPP=524611801622
NEXT_PUBLIC_EMAIL=hola@apoumian.com
NEXT_PUBLIC_AUDITORIAS_URL=https://auditorias.apoumian.com
