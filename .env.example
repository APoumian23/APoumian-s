# Número de WhatsApp en formato internacional, sin + ni espacios. Ej. México: 52 + LADA + número
NEXT_PUBLIC_WHATSAPP=524611801622
NEXT_PUBLIC_EMAIL=hola@apoumian.com

# Dónde vive el motor de auditorías. El buscador de /auditorias manda aquí la
# dirección que escribe el visitante. La petición sale de SU navegador, no de
# este servidor: el motor identifica al visitante anónimo con una cookie de su
# propio dominio y lleva el límite de peticiones por esa clave.
NEXT_PUBLIC_AUDITORIAS_URL=https://auditorias.apoumian.com

# Opcional: si lo defines, el formulario de diagnóstico envía correo con Resend.
# Sin esta variable el formulario sigue funcionando y registra la solicitud en el log del servidor.
RESEND_API_KEY=
CONTACTO_TO=hola@apoumian.com
